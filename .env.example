# ===== Akun admin (dibuat sekali, saat database masih kosong) =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ===== Akun & data demo =====
# true = buat akun budi, sari, dimas, wulan dengan DEMO_PASSWORD
SEED_DEMO_USERS=true
DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD
# true = database baru langsung terisi data contoh F&B; false = mulai kosong
DEMO_DATA=true

# ===== Database =====
DB_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ===== Aplikasi =====
APP_PORT=8000
# isi true bila diakses lewat HTTPS (reverse proxy)
COOKIE_SECURE=false
SESSION_HOURS=12
TZ=Asia/Jakarta

# Mirror PyPI bila unduhan dari pypi.org lambat, contoh:
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_INDEX_URL=https://pypi.org/simple
